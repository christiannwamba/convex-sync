{
  "name": "sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --prefix \"[{name}]\" --names \"🚀 BACKEND,⚛️  FRONTEND\" --prefix-colors \"yellow.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@convex-dev/workflow": "^0.2.6",
    "convex": "^1.25.4",
    "next": "15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
